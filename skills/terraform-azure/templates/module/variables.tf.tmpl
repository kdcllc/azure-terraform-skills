variable "organization_name" {
  description = "The organization/project/company identifier used in resource naming"
  type        = string
}

variable "resource" {
  description = "The logical resource name segment used in naming"
  type        = string
}

variable "environment" {
  description = "The environment for which the resource is being created (e.g., dev, test, prod)"
  type        = string
}

variable "location" {
  description = "The Azure region where the resource will be created"
  type        = string
  default     = "eastus"
}

variable "tags" {
  description = "A map of tags to assign to the resource"
  type        = map(string)
  default     = {}
}
